{%- comment -%}
  LunaraLight PDP — 4-icon Feature Grid (Section 3 of 8)
  4-col desktop / 2x2 mobile. Each cell: outline icon + headline + 1-2 line description.
{%- endcomment -%}

<section class="lumeda-pdp__iconrow" id="pdp-icon-features" data-section-id="{{ section.id }}">
  <div class="lumeda-pdp__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="lumeda-pdp__section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="lumeda-pdp__iconrow-grid">
      {%- for block in section.blocks -%}
        <div class="lumeda-pdp__iconrow-cell" {{ block.shopify_attributes }}>
          <div class="lumeda-pdp__iconrow-icon">{{ block.settings.icon_svg }}</div>
          <h3 class="lumeda-pdp__iconrow-title">{{ block.settings.title }}</h3>
          <p class="lumeda-pdp__iconrow-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Icon Row",
  "tag": "section",
  "class": "lumeda-pdp__iconrow-wrap",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (optional)"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon feature",
      "limit": 8,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG markup",
          "default": "<svg viewBox='0 0 32 32' width='40' height='40' fill='none' stroke='#2D1B25' stroke-width='1.5'><circle cx='16' cy='16' r='14'/></svg>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "One or two line description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Icon Row"
    }
  ]
}
{% endschema %}
