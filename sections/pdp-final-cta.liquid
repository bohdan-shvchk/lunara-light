{%- comment -%}
  LunaraLight PDP — Final CTA Band (Section 8 of 8)
  Full-width band, dark navy bg, big headline + subhead + primary pill CTA.
{%- endcomment -%}

<section class="lumeda-pdp__finalcta" id="pdp-final-cta" data-section-id="{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="lumeda-pdp__container lumeda-pdp__container--narrow lumeda-pdp__finalcta-inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="lumeda-pdp__eyebrow lumeda-pdp__eyebrow--invert">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="lumeda-pdp__finalcta-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="lumeda-pdp__finalcta-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="lumeda-pdp__finalcta-actions">
      <a href="#pdp-hero" class="lumeda-pdp__btn lumeda-pdp__btn--primary lumeda-pdp__btn--lg">{{ section.settings.cta_label }}</a>
    </div>

    {%- if section.settings.trust_line != blank -%}
      <p class="lumeda-pdp__finalcta-trust">{{ section.settings.trust_line }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PDP Final CTA",
  "tag": "section",
  "class": "lumeda-pdp__finalcta-wrap",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#2D1B25" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready when you are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visible results in 4 weeks. Or your money back." },
    { "type": "text", "id": "subheading", "label": "Sub-heading", "default": "Join 1,247 customers using FDA-cleared light therapy at home." },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Add to cart — $69.99" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "Free US shipping over $75 · 30-day money back · 1-year warranty" }
  ],
  "presets": [ { "name": "PDP Final CTA" } ]
}
{% endschema %}
