{%- comment -%}
  LunaraLight PDP — UGC video carousel
  Horizontal scroll-snap carousel of vertical 9:16 video cards.
  Until real videos are uploaded, falls back to poster image with "Coming soon" badge.
  Click a card → unmute & play; arrows scroll.
{%- endcomment -%}

<section class="lumeda-pdp__ugc" id="pdp-ugc-videos" data-section-id="{{ section.id }}">
  <div class="lumeda-pdp__container">
    <div class="lumeda-pdp__ugc-header">
      <h2 class="lumeda-pdp__section-heading lumeda-pdp__ugc-heading">
        {%- assign hl = section.settings.highlight_word | default: 'love' -%}
        {%- assign heading = section.settings.heading -%}
        {%- assign parts = heading | split: hl -%}
        {%- if parts.size > 1 -%}
          {{ parts[0] }}<span class="lumeda-pdp__ugc-highlight" style="color: {{ section.settings.highlight_color }};">{{ hl }}</span>{{ parts[1] }}
        {%- else -%}
          {{ heading }}
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="lumeda-pdp__ugc-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="lumeda-pdp__ugc-wrapper">
      <button class="lumeda-pdp__ugc-nav lumeda-pdp__ugc-nav--prev" aria-label="Previous video" type="button">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="lumeda-pdp__ugc-track" data-ugc-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            <article class="lumeda-pdp__ugc-card" data-ugc-card {{ block.shopify_attributes }}>
              <div class="lumeda-pdp__ugc-media">
                {%- if block.settings.video_file != blank -%}
                  <video
                    class="lumeda-pdp__ugc-video"
                    data-ugc-video
                    playsinline
                    muted
                    loop
                    preload="metadata"
                    {% if block.settings.poster %}poster="{{ block.settings.poster | image_url: width: 720 }}"{% endif %}
                    src="{{ block.settings.video_file.sources[0].url }}"
                  ></video>
                {%- elsif block.settings.poster -%}
                  <img
                    class="lumeda-pdp__ugc-poster-img"
                    src="{{ block.settings.poster | image_url: width: 720 }}"
                    alt="{{ block.settings.caption | default: 'Customer testimonial' }}"
                    loading="lazy"
                    width="540"
                    height="960"
                  />
                  <span class="lumeda-pdp__ugc-soon">Video coming soon</span>
                {%- else -%}
                  <div class="lumeda-pdp__ugc-placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}

                {%- if block.settings.video_file != blank -%}
                  <button class="lumeda-pdp__ugc-mute" type="button" data-ugc-mute aria-label="Toggle sound">
                    <svg class="lumeda-pdp__ugc-mute-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                    <svg class="lumeda-pdp__ugc-mute-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                  </button>
                  <button class="lumeda-pdp__ugc-play" type="button" data-ugc-play aria-label="Play / pause">
                    <svg class="lumeda-pdp__ugc-play-icon" viewBox="0 0 24 24" width="24" height="24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    <svg class="lumeda-pdp__ugc-pause-icon" viewBox="0 0 24 24" width="24" height="24" fill="#fff" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                  </button>
                {%- endif -%}
              </div>

              {%- if block.settings.caption != blank -%}
                <div class="lumeda-pdp__ugc-caption-wrap">
                  <p class="lumeda-pdp__ugc-caption">"{{ block.settings.caption }}"</p>
                  <div class="lumeda-pdp__ugc-stars" aria-label="5 star rating">
                    {%- for i in (1..5) -%}
                      <svg viewBox="0 0 20 20" fill="#E8455F" width="14" height="14"><path d="M10 1l2.6 5.7 6.2.7-4.6 4.3 1.2 6.2L10 14.8 4.6 17.9l1.2-6.2L1.2 7.4l6.2-.7z"/></svg>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button class="lumeda-pdp__ugc-nav lumeda-pdp__ugc-nav--next" aria-label="Next video" type="button">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP UGC Videos",
  "tag": "section",
  "class": "lumeda-pdp-section lumeda-pdp-section--ugc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our customers love the results" },
    { "type": "text", "id": "highlight_word", "label": "Word to highlight in heading", "default": "love" },
    { "type": "color", "id": "highlight_color", "label": "Highlight color", "default": "#E8455F" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video card",
      "limit": 12,
      "settings": [
        { "type": "video", "id": "video_file", "label": "Video file (vertical 9:16 recommended)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image (used as fallback when no video)" },
        { "type": "text", "id": "caption", "label": "Caption (overlay text)" },
        { "type": "text", "id": "alt", "label": "Accessibility alt text" }
      ]
    }
  ],
  "presets": [{ "name": "PDP UGC Videos" }]
}
{% endschema %}
