{%- comment -%}
  LunaraLight PDP — Hero / Buy Box (Section 2 of 8) — v2 LOCKED LAYOUT
  2-col desktop with sticky right buy box. Mobile stacks gallery → info.
  LOCKED order in right column:
    1) BEST SELLER chip
    2) H1 title
    3) Bold-leadin checkmark bullets (highlight blocks)
    4) Outline quiz button
    5) Stars + review count
    6) Price block (current + was + SAVE pill)
    7) Shipping micro-line
    8) Stock urgency banner (cream)
    9) ADD TO CART solid navy
    10) BUY IT NOW outline navy
    11) 2x2 trust grid
    12) Divider + benefit checklist (arctic-blue circle bullets)
    13) Payment icon row
{%- endcomment -%}

<section class="lumeda-pdp__hero" id="pdp-hero" data-section-id="{{ section.id }}">
  <div class="lumeda-pdp__hero-grid">

    {%- comment -%} ===== Left: Gallery ===== {%- endcomment -%}
    <div class="lumeda-pdp__gallery">
      {%- if product.media.size > 0 -%}
        <div class="lumeda-pdp__gallery-main" id="lumedaGalleryMain">
          {%- assign featured = product.featured_media -%}
          <img
            src="{{ featured.preview_image | image_url: width: 1200 }}"
            srcset="{{ featured.preview_image | image_url: width: 600 }} 600w, {{ featured.preview_image | image_url: width: 1200 }} 1200w, {{ featured.preview_image | image_url: width: 2000 }} 2000w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ featured.alt | default: product.title | escape }}"
            width="1200"
            height="1200"
            loading="eager"
            id="lumedaGalleryMainImg"
          >
        </div>
        {%- if product.media.size > 1 -%}
          <div class="lumeda-pdp__gallery-thumbs" role="list">
            {%- for media in product.media limit: 8 -%}
              <button type="button" class="lumeda-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-media-url="{{ media.preview_image | image_url: width: 1200 }}" aria-label="Show image {{ forloop.index }}">
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- comment -%} ===== Right: Buy Box (sticky on desktop) ===== {%- endcomment -%}
    <div class="lumeda-pdp__buybox">

      {%- comment -%} (1) Best-seller chip {%- endcomment -%}
      {%- if section.settings.bestseller_chip != blank -%}
        <span class="lumeda-pdp__bestseller-chip">{{ section.settings.bestseller_chip }}</span>
      {%- endif -%}

      {%- comment -%} (2) H1 title {%- endcomment -%}
      <h1 class="lumeda-pdp__title">{{ product.title }}</h1>

      {%- comment -%} (3) Bullet list — bold lead-in pattern {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="lumeda-pdp__highlights lumeda-pdp__highlights--leadin">
          {%- for block in section.blocks -%}
            {%- if block.type == 'highlight' -%}
              <li class="lumeda-pdp__highlight" {{ block.shopify_attributes }}>
                <span class="lumeda-pdp__highlight-tick" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="14" height="14"><path d="M16.7 5.3l-9 9-3.4-3.4-1.4 1.4 4.8 4.8 10.4-10.4z" fill="#FFFFFF"/></svg>
                </span>
                <span class="lumeda-pdp__highlight-text">
                  {%- if block.settings.lead != blank -%}<strong>{{ block.settings.lead }}</strong> — {% endif -%}{{ block.settings.text }}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} (4) Quiz button {%- endcomment -%}
      {%- if section.settings.quiz_label != blank -%}
        <a href="{{ section.settings.quiz_link | default: '#' }}" class="lumeda-pdp__quiz-btn">{{ section.settings.quiz_label }}</a>
      {%- endif -%}

      {%- comment -%} (5) Star rating row {%- endcomment -%}
      <div class="lumeda-pdp__rating">
        <span class="lumeda-pdp__stars" aria-label="{{ section.settings.rating_value }} out of 5 stars">
          {%- assign rating = section.settings.rating_value | times: 1 -%}
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 20 20" fill="{% if i <= rating %}#E8455F{% else %}#FCCDD0{% endif %}" width="16" height="16"><path d="M10 1l2.6 5.7 6.2.7-4.6 4.3 1.2 6.2L10 14.8 4.6 17.9l1.2-6.2L1.2 7.4l6.2-.7z"/></svg>
          {%- endfor -%}
        </span>
        <span class="lumeda-pdp__rating-num">{{ section.settings.rating_value }}</span>
        <span class="lumeda-pdp__rating-sep">·</span>
        {%- if section.settings.review_count != blank -%}
          <a href="#pdp-reviews" class="lumeda-pdp__review-link">{{ section.settings.review_count }}</a>
        {%- endif -%}
      </div>

      {%- comment -%} (6) Price block {%- endcomment -%}
      <div class="lumeda-pdp__price">
        <span class="lumeda-pdp__price-current">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="lumeda-pdp__price-was">{{ product.compare_at_price | money }}</span>
          {%- assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          <span class="lumeda-pdp__price-save">SAVE {{ discount }}%</span>
        {%- endif -%}
      </div>

      {%- comment -%} (7) Shipping micro-line {%- endcomment -%}
      {%- if section.settings.shipping_line != blank -%}
        <p class="lumeda-pdp__shipping-line">{{ section.settings.shipping_line }}</p>
      {%- endif -%}

      {%- comment -%} (8) Stock urgency banner {%- endcomment -%}
      {%- if section.settings.urgency_text != blank -%}
        <div class="lumeda-pdp__urgency">
          <span class="lumeda-pdp__urgency-icon" aria-hidden="true">🔥</span>
          <span class="lumeda-pdp__urgency-text">{{ section.settings.urgency_text }}</span>
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'lumeda-pdp__form', id: 'lumedaProductForm' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {%- if product.has_only_default_variant == false -%}
          {%- for option in product.options_with_values -%}
            <div class="lumeda-pdp__variant">
              <label class="lumeda-pdp__variant-label">{{ option.name }}: <span class="lumeda-pdp__variant-selected" data-option-name="{{ option.name }}">{{ option.selected_value }}</span></label>
              <div class="lumeda-pdp__variant-options" role="radiogroup">
                {%- for value in option.values -%}
                  <button type="button" class="lumeda-pdp__variant-option{% if value == option.selected_value %} is-selected{% endif %}" data-option-index="{{ forloop.index0 }}" data-option-value="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} (9) ADD TO CART — full-width with price {%- endcomment -%}
        <button type="submit" name="add" class="lumeda-pdp__atc lumeda-pdp__atc--full" {% if product.available == false %}disabled{% endif %}>
          <span class="lumeda-pdp__atc-text">
            {% if product.available %}{{ section.settings.cta_label | default: 'Add to cart' }} — {{ product.price | money }}{% else %}Sold out{% endif %}
          </span>
        </button>

        {%- comment -%} (10) BUY IT NOW outline {%- endcomment -%}
        {%- if section.settings.show_buy_now -%}
          {{ form | payment_button }}
        {%- endif -%}
      {%- endform -%}

      {%- comment -%} (11) 2x2 trust grid {%- endcomment -%}
      {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
      {%- if trust_blocks.size > 0 -%}
        <div class="lumeda-pdp__trust-grid">
          {%- for block in trust_blocks -%}
            <div class="lumeda-pdp__trust-card" {{ block.shopify_attributes }}>
              <span class="lumeda-pdp__trust-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D1B25" stroke-width="2"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6z"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D1B25" stroke-width="2"><path d="M2 8h11v8H2z"/><path d="M13 11h5l3 3v2h-8z"/><circle cx="6.5" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/></svg>
                  {%- when 'sparkle' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D1B25" stroke-width="2" stroke-linecap="round"><path d="M12 3v6M12 15v6M3 12h6M15 12h6M5.6 5.6l4.2 4.2M14.2 14.2l4.2 4.2M5.6 18.4l4.2-4.2M14.2 9.8l4.2-4.2"/></svg>
                  {%- when 'clock' -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D1B25" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D1B25" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endcase -%}
              </span>
              <span class="lumeda-pdp__trust-text">{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} (12) Divider + benefit checklist {%- endcomment -%}
      {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
      {%- if benefit_blocks.size > 0 -%}
        <hr class="lumeda-pdp__divider">
        <ul class="lumeda-pdp__benefits">
          {%- for block in benefit_blocks -%}
            <li class="lumeda-pdp__benefit" {{ block.shopify_attributes }}>
              <span class="lumeda-pdp__benefit-tick" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="11" height="11"><path d="M16.7 5.3l-9 9-3.4-3.4-1.4 1.4 4.8 4.8 10.4-10.4z" fill="#2D1B25"/></svg>
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} (13) Payment icons {%- endcomment -%}
      {%- if section.settings.payment_icons -%}
        <div class="lumeda-pdp__payment-icons" aria-label="Accepted payments">
          <span>VISA</span><span>AMEX</span><span>MC</span><span>PAYPAL</span><span>SHOP PAY</span><span>AFTERPAY</span>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Hero",
  "tag": "section",
  "class": "lumeda-pdp__hero-wrap",
  "settings": [
    { "type": "text", "id": "bestseller_chip", "label": "Best-seller chip", "default": "★ BEST SELLER · 10,000+ SOLD" },
    { "type": "text", "id": "quiz_label", "label": "Quiz button label", "default": "+ FIND MY LED MODE FREE QUIZ" },
    { "type": "url", "id": "quiz_link", "label": "Quiz button link" },
    { "type": "text", "id": "rating_value", "label": "Star rating (1-5)", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count link text", "default": "2,847 Reviews" },
    { "type": "text", "id": "cta_label", "label": "Add to cart text", "default": "ADD TO CART" },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show dynamic checkout (Buy Now / Shop Pay)", "default": true },
    { "type": "text", "id": "shipping_line", "label": "Shipping micro-line", "default": "Free US shipping over $50 · In stock · Ships within 24 hours" },
    { "type": "text", "id": "urgency_text", "label": "Stock urgency text", "default": "Only 12 left in stock. Sold out 4 times last month — secure yours before it's gone." },
    { "type": "checkbox", "id": "payment_icons", "label": "Show payment method icons", "default": true }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Top bullet (bold lead-in)",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "lead", "label": "Bold lead-in" },
        { "type": "text", "id": "text", "label": "Descriptor" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust grid card",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "shield",  "label": "Shield (money back)" },
            { "value": "truck",   "label": "Truck (shipping)" },
            { "value": "sparkle", "label": "Sparkle (skin types)" },
            { "value": "clock",   "label": "Clock (time)" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "text", "label": "Card text" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit checklist row",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "text", "label": "Benefit text" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Hero" }
  ]
}
{% endschema %}
