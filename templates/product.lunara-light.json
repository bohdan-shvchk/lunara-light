    "faq": {
      "type": "pdp-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "How far should I hold the panel from my skin?",
            "answer": "<p>15–20cm for red light (660nm) for skin benefits. 20–30cm for near-infrared (850nm) for deeper tissue. The panel does not need to touch your skin — distance is part of the protocol.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "How long are sessions and how often should I use it?",
            "answer": "<p>10 minutes per zone, once daily. Start with 5 minutes if you're new to light therapy. Consistent daily use over 4–8 weeks produces the most visible results.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Is it safe to use near the eyes?",
            "answer": "<p>Always wear the included protective goggles when directing the panel at your face or neck. The panel emits no UV radiation, but direct eye exposure to concentrated red/infrared LEDs is not recommended.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Can I use it on my face and body?",
            "answer": "<p>Yes. The 216-LED panel is large enough to cover the full face, neck, upper back, lower back, shoulders, or knees in a single session. Simply reposition the stand between zones.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "What's the difference between the RD and IR modes?",
            "answer": "<p>RD (660nm red light) works at the skin surface — best for collagen, skin tone, and wound healing. IR (850nm near-infrared) penetrates deeper — best for muscle recovery, joint inflammation, and pain. The RD+IR combined mode delivers both simultaneously.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "How long until I see results?",
            "answer": "<p>Most customers notice improved sleep, reduced soreness, and skin texture changes within 2–3 weeks of daily use. Significant collagen-related skin improvements typically show at 6–8 weeks. Joint and pain results vary by condition severity.</p>"
          }
        },
        "q7": {
          "type": "faq",
          "settings": {
            "question": "Is the EU power adapter included?",
            "answer": "<p>Yes. Every panel ships with a CE-certified EU power adapter, adjustable aluminium stand, and protective goggles. Nothing extra to buy.</p>"
          }
        },
        "q8": {
          "type": "faq",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>30-day full refund — no questions asked. If you're not satisfied for any reason within 30 days of delivery, contact us and we'll arrange a free return label and full refund.</p>"
